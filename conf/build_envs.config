/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for pre-building conda environments
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    This profile triggers all modules so that their conda environments are
    created. Run with -stub-run to avoid executing the real analysis:

        nextflow run main.nf -profile build_envs,mamba -stub-run

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Build environments profile'
    config_profile_description = 'Triggers all modules to pre-build their conda environments (use with -stub-run)'

    // BEAST2 XML template (single is sufficient to trigger all processes)
    template_xml               = "${projectDir}/tests/data/upscaled_growth_1_2e-3_clock.xml"

    // Sequence filtering
    exclude_ids                = "${projectDir}/conf/exclude_list.csv"
    filter_invalid_dates       = true

    // Enable check_new_submissions to build that environment too
    check_new_submissions      = true

    // BEAST2 run options (minimal — just enough to trigger the processes)
    beast_repeats              = 1
    beast_seed                 = 42

    // Build initial tree with reference (triggers IQTREE, PRUNE_TREE, SEQKIT_GREP_REF)
    build_initial_tree_with_reference = true
    reference_date             = '2007-11'

    // Pathoplexus download filter (pinned for reproducibility)
    pathoplexus_date_from      = '2026-01-01'
    pathoplexus_submitted_date = '2026-06-06'

    // Output
    outdir                     = 'build_envs_results'
}
