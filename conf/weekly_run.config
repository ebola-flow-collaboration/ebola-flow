/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for weekly scheduled runs
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Same as daily but always runs regardless of whether there are new Pathoplexus
    submissions today (does NOT check for new submissions).

    Use as follows:
        nextflow run PHAC-NML/ebola-flow -profile weekly_run,<docker/singularity/mamba>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 12,
        memory: '216GB',
        time: '10.d'
    ]
}

params {
    config_profile_name        = 'Weekly run profile'
    config_profile_description = 'Weekly scheduled run — always runs without checking for new submissions'

    // BEAST2 XML templates (multiple)
    template_xml               = [
        "${projectDir}/template_beast_xmls/upscaled_growth_rate_default_epop_priors/coal_exp_fixed_clock_8_5e-4.xml",
        "${projectDir}/template_beast_xmls/upscaled_growth_rate_default_epop_priors/coal_exp_gamma_clock.xml"
    ]

    // Sequence filtering
    exclude_ids                = "${projectDir}/conf/exclude_list.csv"
    filter_invalid_dates       = true

    // Do NOT check for new submissions — always run
    check_new_submissions      = false

    // BEAST2 run options
    beast_repeats              = 15
    beast2_packages            = 'BDMM-Prime'
    beast_seed                 = 42       // Fixed seed for reproducibility & -resume caching

    // Build initial tree (without reference or outgroup)
    build_initial_tree             = true
    // build_initial_tree_with_reference = true
    // reference_date             = '2007-11'


    // // Outgroup sequences for tree rooting (covering 2007)
    // outgroup_date_from         = '2007-01-01'
    // outgroup_date_to           = '2007-12-31'

    // TreeTime analysis options
    run_treetime               = true
    treetime_clock_filter      = 3.0      // Remove sequences with z-score > 3 SD
    treetime_clock_filter_method = 'local'


    // Pathoplexus download filter
    pathoplexus_date_from      = '2026-01-01'

    // Output
    outdir                     = "${params.outdir_base}/${new Date().format('yyyy-MM-dd_HH-mm-ss')}"
}
